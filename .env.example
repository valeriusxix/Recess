# Web OAuth client ID from Google Cloud Console.
# Authorized JavaScript origins must include the URL you open the app on
# (for local dev: http://localhost:5173).
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Deployed Recess pools on BNB Smart Chain. Leave a line blank until that pool is deployed.
# USDT and USDC are separate pools. A deposit in one does not back the other.
VITE_RECESS_POOL=
VITE_RECESS_POOL_USDC=
# Creation block of the deployed pool; used to load full wallet activity.
VITE_RECESS_POOL_START_BLOCK=127017054

# Privy app id from the Privy dashboard.
# Enable only Email and Google as login methods, add Google OAuth,
# and allow this site's origin (local dev: http://localhost:5173).
VITE_PRIVY_APP_ID=

# Server-only Binance Web3 credentials. Do not prefix these with VITE_.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_SECRET_KEY=

# Optional port for `node server/binanceProxy.mjs`. Default 8787.
RECESS_API_PORT=8787

# Used only by `forge script script/Deploy.s.sol --broadcast`.
# Leave this blank in the repo. Do not commit a real key.
DEPLOYER_PRIVATE_KEY=
