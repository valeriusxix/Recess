# The navbar stays on devnet until the mainnet switch is enabled.
VITE_SOLANA_CLUSTER=devnet

# Hermes API key. Required for live TSLA prices, buys, and claims.
# The same key is read by npm run settle as PYTH_API_KEY.
# Do not commit a real key. Put it in app/.env.
VITE_PYTH_API_KEY=
PYTH_API_KEY=
